<?xml version="1.0" encoding="utf-8"?>

<XnaContent xmlns:Graphics="ReLogic.Content.Pipeline">
	<Asset Type="Graphics:DynamicFontDescription">
		<!--
		把下面的“HarmonyOS Sans SC”修改为字体的名字，不需要引号，有空格则空格
		-->
		<FontName>HarmonyOS Sans SC</FontName>
		
		<!--
                                修改下面的数值大小来改变字体的大小，我提供了我测试得出的适合的数值，如果出现了字体模糊的情况
                                请自行修改数值
		-->
		<Size>36</Size>
		
		<!--
		Spacing is a float value, measured in pixels. Modify this value to change
		the amount of spacing in between characters.
		-->
		<Spacing>0</Spacing>
		
		<!--
		UseKerning controls the layout of the font. If this value is true, kerning information
		will be used when placing characters.
		-->
		<UseKerning>true</UseKerning>
		
		<!--
		Style controls the default style of the font. Valid entries are "Regular", "Bold", "Italic",
		and "Bold, Italic", and are case sensitive.
		样式控制字体的默认样式。有效条目为“常规”、“粗体”、“斜体”、，
		以及“粗体、斜体”，并且区分大小写。
		-->
		<Style>Regular</Style>
		
		<!--
		DefaultCharacter is the default character will be substituted if you draw
		or measure text that contains characters which were not included in the font.
		(However, you still need to include DefaultCharacter in the CharacterRegions below)
		-->
		<DefaultCharacter>*</DefaultCharacter>

		<!--
		VerticalOffset controls how the maximum height of the font is determined.
		"DefaultFontAscent" will use the maximum ascent size of the default font for reference.
		"MaxAscent" will use the maximum ascent size found across all fonts used for reference.
		
		"DefaultFontAscent" is the suggested option here.
		-->
		<VerticalOffset>MaxAscent</VerticalOffset>


		<!--
		CharacterRegions control what letters are available in the font. Every
		character from Start to End will be built and made available for drawing.
		The characters are ordered according to the Unicode standard.
		
		Character regions may also override the default FontName, Size, and Style. (See above for details)
		-->
		<CharacterRegions>

			<!-- English -->
			<CharacterRegion>
				<Start>&#x20;</Start>
				<End>&#xA9;</End>
			</CharacterRegion>

			<!-- Latin Characters -->
			<CharacterRegion>
				<FontName>HarmonyOS Sans SC</FontName>
				<Size>36</Size>
				<Style>Regular</Style>
				<Start>&#xAA;</Start>
				<End>&#x385;</End>
			</CharacterRegion>

			<!-- Greek and Coptic (包含 α U+03B1) -->
			<CharacterRegion>
 			<FontName>HarmonyOS Sans SC</FontName>
  			<Size>36</Size>
  			<Style>Regular</Style>
  			<Start>&#x0370;</Start>
  			<End>&#x03FF;</End>
			</CharacterRegion>


			<!-- Extra Symbols -->
			<CharacterRegion>
				<FontName>HarmonyOS Sans SC</FontName>
				<Size>36</Size>
				<Style>Regular</Style>
				<Start>&#x2013;</Start>
				<End>&#x303F;</End>
			</CharacterRegion>

			<!-- Cyrillic (Russian) -->
			<CharacterRegion>
				<FontName>HarmonyOS Sans SC</FontName>
				<Size>36</Size>
				<Style>Regular</Style>
				<Start>&#x0400;</Start>
				<End>&#x04FF;</End>
			</CharacterRegion>

			<!-- Simplified Chinese -->
			<CharacterRegion>
				<FontName>HarmonyOS Sans SC</FontName>
				<Size>36</Size>
				<Style>Regular</Style>
				<Start>&#x4E00;</Start>
				<End>&#x9FFF;</End>
			</CharacterRegion>

			<!-- Full Width English (For Simplified Chinese) -->
			<CharacterRegion>
				<FontName>HarmonyOS Sans SC</FontName>
				<Size>36</Size>
				<Style>Regular</Style>
				<Start>&#xFF01;</Start>
				<End>&#xFF60;</End>
			</CharacterRegion>

		</CharacterRegions>
	</Asset>
</XnaContent>
